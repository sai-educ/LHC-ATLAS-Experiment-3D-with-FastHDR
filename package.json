{
  "name": "lhc-atlas-experiment-3d",
  "private": true,
  "description": "Interactive 3D visualization of particle collisions in the ATLAS detector",
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.js --bundle --format=iife --target=es2020 --outfile=dist/app.js --minify",
    "dev": "esbuild src/main.js --bundle --format=iife --target=es2020 --outfile=dist/app.js --sourcemap --watch --servedir=. --serve=localhost:8000",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "three": "0.159.0"
  }
}
